{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@own/computer-use",
  "version": "0.0.0",
  "private": true,
  "description": "own-open-code: Windows computer-use plugin (own.computer-use)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "typecheck": "\"$npm_execpath\" check --no-script -p tsconfig.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "test": "\"$npm_execpath\" test",
    "test:unit": "\"$npm_execpath\" test test/unit",
    "test:e2e": "\"$npm_execpath\" test test/e2e"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@own/protocol": "workspace:*",
    "@own/runtime": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
