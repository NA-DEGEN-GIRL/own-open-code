{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@own/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "own-open-code: RPC own.accounts, own.remote, own.team, own.computer, own.import, own.harness and own.creator definitions and shared schemas",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./rpc-routing": "./src/rpc-routing.ts",
    "./rpc-remote": "./src/rpc-remote.ts",
    "./remote-browser": "./src/remote-browser.ts",
    "./rpc-computer": "./src/rpc-computer.ts",
    "./rpc-team": "./src/rpc-team.ts",
    "./rpc-team-routing": "./src/rpc-team-routing.ts",
    "./rpc-team-text": "./src/rpc-team-text.ts",
    "./rpc-import": "./src/rpc-import.ts",
    "./rpc-import-routing": "./src/rpc-import-routing.ts",
    "./rpc-harness": "./src/rpc-harness.ts",
    "./rpc-harness-routing": "./src/rpc-harness-routing.ts",
    "./rpc-creator": "./src/rpc-creator.ts",
    "./creator": "./src/creator.ts",
    "./portable": "./src/portable.ts",
    "./kind": "./src/kind.ts",
    "./codex-models": "./src/codex-models.ts",
    "./limit-model": "./src/limit-model.ts",
    "./limit-rank": "./src/limit-rank.ts",
    "./notes": "./src/notes.ts",
    "./ideas": "./src/ideas.ts",
    "./side": "./src/side.ts",
    "./policy": "./src/policy.ts",
    "./preset": "./src/preset.ts",
    "./protected-paths": "./src/protected-paths.ts",
    "./tool-updates": "./src/tool-updates.ts",
    "./speed": "./src/speed.ts",
    "./voice": "./src/voice.ts",
    "./search-key": "./src/search-key.ts",
    "./compaction": "./src/compaction.ts",
    "./compaction-cache": "./src/compaction-cache.ts",
    "./output-limit": "./src/output-limit.ts",
    "./token": "./src/token.ts",
    "./mcp-rules": "./src/mcp-rules.ts",
    "./mcp-secrets": "./src/mcp-secrets.ts",
    "./mcp-host-rules": "./src/mcp-host-rules.ts",
    "./skillset": "./src/skillset.ts",
    "./plugin": "./src/plugin.ts"
  },
  "scripts": {
    "typecheck": "\"$npm_execpath\" check --no-script -p tsconfig.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "test": "\"$npm_execpath\" test"
  },
  "dependencies": {
    "@opencode/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
