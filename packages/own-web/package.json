{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@own/web",
  "version": "0.0.0",
  "private": true,
  "description": "own-open-code: web UI",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "size": "\"$npm_execpath\" run script/bundle-size.ts",
    "typecheck": "\"$npm_execpath\" check --no-script -p tsconfig.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "test": "\"$npm_execpath\" test --conditions=browser --preload ./happydom.ts --preload ../ui/test/solid-jsx.ts --timeout=30000 --parallel ./src",
    "test:quick": "\"$npm_execpath\" test --conditions=browser --preload ./happydom.ts --preload ../ui/test/solid-jsx.ts --timeout=30000 --parallel --changed=main ./src",
    "test:e2e": "\"$npm_execpath\" run build && playwright test --config e2e/playwright.config.ts",
    "test:e2e:main": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:all": "\"$npm_execpath\" ../../own/scripts/test/heavy.ts bun script/e2e-all.ts",
    "test:e2e:sections": "playwright test --config e2e/sections/playwright.config.ts",
    "test:e2e:sidebar": "playwright test --config src/sidebar/e2e/playwright.config.ts",
    "test:e2e:requests": "playwright test --config e2e/requests/playwright.config.ts",
    "test:e2e:review": "playwright test --config e2e/review/playwright.config.ts",
    "test:e2e:terminal": "playwright test --config e2e/terminal/playwright.config.ts",
    "test:e2e:timeline-ops": "playwright test --config e2e/timeline-ops/playwright.config.ts",
    "test:e2e:composer-ext": "playwright test --config e2e/composer-ext/playwright.config.ts",
    "test:e2e:workspace": "playwright test --config e2e/workspace/playwright.config.ts",
    "test:e2e:p5": "playwright test --config e2e/p5/playwright.config.ts",
    "test:e2e:remote": "playwright test --config e2e/remote/playwright.config.ts",
    "test:e2e:mcp-hosts": "playwright test --config e2e/mcp-hosts/playwright.config.ts",
    "test:e2e:review-git": "playwright test --config e2e/review-git/playwright.config.ts",
    "test:e2e:files": "playwright test --config e2e/files/playwright.config.ts",
    "test:e2e:worktree-bg": "playwright test --config e2e/worktree-bg/playwright.config.ts",
    "test:e2e:composer-plus": "playwright test --config e2e/composer-plus/playwright.config.ts",
    "test:e2e:session-ux": "playwright test --config e2e/session-ux/playwright.config.ts",
    "test:e2e:palette-shell": "playwright test --config e2e/palette-shell/playwright.config.ts",
    "test:e2e:linux-build": "playwright test --config e2e/linux-build/playwright.config.ts",
    "test:e2e:p7": "playwright test --config e2e/p7/playwright.config.ts",
    "test:e2e:gateway": "playwright test --config e2e/gateway/playwright.config.ts",
    "test:e2e:team": "playwright test --config e2e/team/playwright.config.ts",
    "test:e2e:presets": "playwright test --config e2e/presets/playwright.config.ts",
    "test:e2e:claude-models": "playwright test --config e2e/claude-models/playwright.config.ts",
    "test:e2e:import": "playwright test --config e2e/import/playwright.config.ts",
    "test:e2e:prompts": "playwright test --config e2e/prompts/playwright.config.ts",
    "test:e2e:creator": "playwright test --config e2e/creator/playwright.config.ts",
    "test:e2e:websearch": "playwright test --config e2e/websearch/playwright.config.ts",
    "test:e2e:tools": "playwright test --config e2e/tools/playwright.config.ts",
    "test:e2e:ui-audit": "playwright test --config e2e/ui-audit/playwright.config.ts",
    "test:e2e:mobile": "playwright test --config e2e/mobile/playwright.config.ts",
    "test:integration": "playwright test --config e2e/integration/playwright.config.ts",
    "dev:service": "\"$npm_execpath\" dev/serve.ts",
    "check:fallback": "\"$npm_execpath\" run build && \"$npm_execpath\" dev/web-fallback-check.ts",
    "bench": "\"$npm_execpath\" e2e/performance/run.ts",
    "bench:gate": "\"$npm_execpath\" e2e/performance/run.ts --gate"
  },
  "dependencies": {
    "@kobalte/core": "catalog:",
    "@opencode/client": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/session-ui": "workspace:*",
    "@opencode/ui": "workspace:*",
    "@opencode/util": "workspace:*",
    "@own/protocol": "workspace:*",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/media": "catalog:",
    "@tanstack/solid-virtual": "catalog:",
    "dompurify": "catalog:",
    "effect": "catalog:",
    "ghostty-web": "github:anomalyco/ghostty-web#83c0a07b8628b748aed073b232cb4b52a6ca11c1",
    "solid-js": "catalog:",
    "three": "0.180.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "catalog:",
    "@types/three": "0.180.0",
    "@typescript/native": "catalog:",
    "happy-dom": "20.11.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  }
}
