{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@own/accounts",
  "version": "0.0.0",
  "private": true,
  "description": "own-open-code: accounts/slots plugin (own.accounts)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "\"$npm_execpath\" check --no-script -p tsconfig.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "test": "\"$npm_execpath\" test --parallel=6 --timeout=30000 --path-ignore-patterns='**/*.e2e.test.ts' --path-ignore-patterns='**/e2e.test.ts' --path-ignore-patterns='test/remote/e2e/**' --timings=test/timings.json",
    "test:quick": "\"$npm_execpath\" test --changed=main --parallel=6 --timeout=30000 --path-ignore-patterns='**/*.e2e.test.ts' --path-ignore-patterns='**/e2e.test.ts' --path-ignore-patterns='test/remote/e2e/**'",
    "test:e2e": "\"$npm_execpath\" ../../own/scripts/test/heavy.ts bun test --parallel=3 --timeout=30000 e2e.test.ts test/remote/e2e"
  },
  "dependencies": {
    "@opencode/ai": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@own/protocol": "workspace:*",
    "@own/runtime": "workspace:*",
    "effect": "catalog:",
    "jose": "6.0.11",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
